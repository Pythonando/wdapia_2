# Copie para .env e troque as senhas/chaves antes de subir.
ELASTIC_VERSION=8.17.0
COMPOSE_PROJECT_NAME=observability

# Senha do superusuario "elastic" (usada no login do Kibana e pelos beats/APM)
ELASTIC_PASSWORD=troque-esta-senha
# Senha do usuario interno kibana_system
KIBANA_PASSWORD=troque-esta-senha-kibana
# Chaves do Kibana (minimo 32 caracteres cada)
KIBANA_ENCRYPTION_KEY=troque-por-uma-chave-com-32-ou-mais-caracteres-1
KIBANA_REPORTING_KEY=troque-por-uma-chave-com-32-ou-mais-caracteres-2
KIBANA_SECURITY_KEY=troque-por-uma-chave-com-32-ou-mais-caracteres-3

# Memoria da JVM do Elasticsearch
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Endpoint do Django monitorado pelo Heartbeat (uptime / tempo de resposta)
# Django rodando no host: http://host.docker.internal:8000
APP_URL=http://host.docker.internal:8000
APP_HEALTH_URL=http://host.docker.internal:8000/health/
APP_HOST=host.docker.internal

# Pasta com arquivos de log do Django (lida pelo Filebeat)
APP_LOG_DIR=./app-logs
