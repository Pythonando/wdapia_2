# Variáveis de ambiente da stack de teste de carga (lido pelo compose no `web`,
# no `worker` e no `locust`). O agente `load-test-runner-geral` preenche.
#
# NÃO aponte para produção e NÃO copie chaves reais: use valores placeholder.
# O `.env` do projeto NÃO é carregado de propósito — ele pode conter a URL do
# banco de produção e chaves de serviços pagos, e um teste de carga com elas
# escreveria no banco real e geraria custo.
#
# Marque como 1 quando terminar (o `check_setup.py` lê esta linha).
LOADTEST_ENV_CONFIGURED=0

# --- Django (use os NOMES que o settings.py deste projeto lê) ---------------
# DEBUG é forçado para False pelo compose. Se o settings lê OUTRO nome
# (ex.: DJANGO_DEBUG), defina-o aqui como False — é obrigatório.
# SECRET_KEY=loadtest-insecure-key-not-for-production
# ALLOWED_HOSTS=*

# --- Banco (deve casar com LOADTEST_DB_* do compose: app/app/app, host `db`) -
# Estilo A:  DB_NAME=app  DB_USER=app  DB_PASSWORD=app  DB_HOST=db  DB_PORT=5432
# Estilo B:  DATABASE_URL=postgres://app:app@db:5432/app

# --- Redis / Celery (só se o projeto usa; suba com --with-redis/--with-worker)
# CELERY_BROKER_URL=redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0

# --- Integrações externas: placeholders para o app subir, sem chamar ninguém -
# STRIPE_API_KEY=loadtest
# OPENAI_API_KEY=loadtest

# --- Do teste (opcional; ver locustfile) ------------------------------------
# LOADTEST_HEALTH_PATH=/          # rota leve e pública usada no healthcheck

# --- Ajustes da stack (lidos pelo run_load_test.sh E pelo compose) ----------
# Descomente e ajuste o que diferir do default.
# LOADTEST_WEB_DOCKERFILE=Dockerfile        # relativo à raiz do repo
# LOADTEST_WORKER_DOCKERFILE=Dockerfile
# LOADTEST_WORKER_COMMAND=celery -A config worker -l INFO
# LOADTEST_APP_DIR=/app                     # WORKDIR do código no container
# LOADTEST_CONTAINER_PORT=8000              # porta que o web escuta no container
# LOADTEST_WEB_PORT=8001                    # porta publicada no host
# LOADTEST_DB_IMAGE=postgres:16             # ex.: pgvector/pgvector:pg16
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# LOADTEST_SERVER_CONFIG=gunicorn 2 workers x 2 threads   # texto p/ o relatório
